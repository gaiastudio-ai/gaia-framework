#!/usr/bin/env bash
# Stub go — replays recorded go test output for CI testing.
#
# When called as "go test -v ./...", prints pre-recorded test output
# and exits with the appropriate code. Used by the Go mutation adapter
# bats tests when the real Go toolchain is unavailable.

set -euo pipefail

STUB_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")/.." >/dev/null && pwd)"

case "${1:-}" in
  test)
    shift
    # Check for a fail marker (used by the timeout and killed tests)
    if [ -f "${GAIA_STUB_GO_FAIL:-}" ]; then
      cat "$STUB_DIR/recorded/go-test-killed.txt" 2>/dev/null || \
        printf '=== RUN   TestAddPositive\n--- FAIL: TestAddPositive (0.00s)\n    calc_test.go:7: Add(1, 2) = -1, want 3\nFAIL\n'
      exit 1
    fi
    # Default: all tests pass
    cat "$STUB_DIR/recorded/go-test-passed.txt" 2>/dev/null || \
      printf '=== RUN   TestAddPositive\n--- PASS: TestAddPositive (0.00s)\n=== RUN   TestAddZero\n--- PASS: TestAddZero (0.00s)\nPASS\nok\texample.com/calc\t0.001s\n'
    exit 0
    ;;
  version)
    printf 'go version go1.21.0 darwin/arm64\n'
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
